# =============================================================================
# Snívať environment variables
# Copy this file to `.env` and fill in the values you need.
# The app runs WITHOUT any of these set (demo login works out of the box).
# =============================================================================

# --- App ---
# A stable random string used to sign the session cookie / JWT.
# Generate one: `openssl rand -base64 32` (or any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app. For local dev, http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OAuth providers (OPTIONAL — leave blank to keep them hidden).
# Create an OAuth app at each provider, then paste the Client ID + Secret here.
# =============================================================================

# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook: https://developers.facebook.com/apps/
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Microsoft Entra ID: https://entra.microsoft.com/
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=

# Yahoo: https://developer.yahoo.com/apps/
AUTH_YAHOO_ID=
AUTH_YAHOO_SECRET=

# --- Demo account (credentials provider) ---
# The email/password that the "Continue as demo user" button signs in with.
DEMO_EMAIL=demo@snivat.local
DEMO_PASSWORD=demo1234
