// Snívať database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth.js core models) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  location      String?
  // OAuth provider used for this account (credentials, github, google, ...)
  provider      String    @default("credentials")
  role          String    @default("member") // member | admin
  bannedAt      DateTime? // set = writes blocked + sign-in refused
  // Self-deactivation: profile/posts hidden everywhere; signing back in
  // clears this and restores the account (reversible by design).
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  settings      Settings?
  applications  Application[]
  reactions     Reaction[]
  bookmarks     Bookmark[]
  feedback      PostFeedback[]

  // Follow graph
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")


  // DMs
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("recipient")

  // Notifications
  notifications        Notification[] @relation("recipient")
  triggeredNotifications Notification[] @relation("actor")

  // Stories
  stories    Story[]
  storyViews StoryView[]

  // Profile highlights (curated permanent collections)
  highlights Highlight[]

  // Moderation
  reports    Report[] @relation("reporter")
  modActions Report[] @relation("moderator")

  // DM emoji reactions
  messageReactions MessageReaction[]

  // Poll votes (E's polls; pending schema window)
  pollVotes PollVote[]

  // Groups (v1: owner + members, no channels/roles)
  groupsCreated     Group[]       @relation("GroupCreator")
  groupMemberships  GroupMember[] @relation("GroupMemberships")
}

// Discord-style groups v1: a page with its own post feed. Owner-managed;
// visibility gates the feed, joinMode gates membership.
model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  coverUrl    String?
  // "public" (listed + feed-visible) | "private" (members only)
  visibility  String   @default("public")
  // "open" (join instantly) | "approval" (contact owner — DM deep-link v1)
  joinMode    String   @default("open")
  creatorId   String
  creator     User     @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  posts       Post[]
  createdAt   DateTime @default(now())
}

model GroupMember {
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User     @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  // "owner" | "member" (no richer roles in v1)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- App content ---

// A single "post" is reused across all three sections via `category`:
//   COMMUNITY     -> community discussions / shared experiences
//   JOB_OFFER     -> "I do this kind of work" (Jobs section, offer tab)
//   JOB_REQUEST   -> "I'm looking for someone to do this work" (Jobs section, request tab)
//   JOB_LISTING   -> a job opening to apply to (Job Applications section)
model Post {
  id        String      @id @default(cuid())
  category  String
  title     String
  content   String
  tags      String?
  // Optional structured fields (used for job posts; empty for community)
  budget    String?
  location  String?
  type      String? // e.g. full-time, part-time, contract, freelance
  status    String      @default("open") // open | closed
  // Moderation: hidden posts are excluded from feeds but kept for review.
  hidden    Boolean     @default(false)
  authorId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images       PostImage[]
  comments     Comment[]
  applications Application[]
  reactions    Reaction[]
  bookmarks   Bookmark[]
  reports     Report[]
  notifications Notification[]
  feedback      PostFeedback[]
  polls         Poll[]

  // Optional group ownership — set when posted inside a group page.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([authorId])
  @@index([createdAt])
  @@index([groupId])
}

// A like or dislike on a post. One reaction per user per post (unique).
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   // "like" | "dislike"
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId, createdAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) // drives per-user daily upload caps

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([postId])
  @@index([authorId, createdAt])
}

// A job application made by a user against a JOB_LISTING post.
model Application {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  message   String
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// Per-user system settings.
model Settings {
  id                String  @id @default(cuid())
  userId            String  @unique
  theme             String  @default("light") // light | dark
  accent            String  @default("#dc2626")
  emailNotifications Boolean @default(true)
  publicProfile     Boolean @default(true)
  showEmail          Boolean @default(false)
  background         String? // custom background hex, null = theme default
  isCreator          Boolean @default(false)
  interests          String? // comma-separated interest tags (C's picker; inert until wired)

  // ?????? Pending schema window (drafted 2026-08-25; reconcile E/F shapes) ??????
  notifyMessages     Boolean @default(true) // in-app DM notifications on/off
  weeklyDigest       Boolean @default(false) // weekly email digest (sending needs Resend key)
  presenceOptOut     Boolean @default(false) // opt out of showing "Online" indicator
  status             String? // free-text presence status (C's presence round)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}



// -- Social layer (added 2026-08-21) ------------------------------------------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// Direct message between two users. Thread = messages in both directions.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  reports Report[]

  reactions MessageReaction[]

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
}

// IG-style emoji reaction on a DM. One user may react with each emoji once;
// tapping again removes it (toggle handled app-side via upsert/delete).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Ephemeral post that disappears 24h after creation.
model Story {
  id        String   @id @default(cuid())
  authorId  String
  imageUrl  String?
  caption   String?
  bg        String? // hex background for text-only stories
  musicUrl  String? // attached track (E's music notes; pending schema window)
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]
  reports Report[]

  @@index([authorId, expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

// Instagram-style highlight: a named, permanent collection of images
// curated from the profile. Cover defaults to the first item.
model Highlight {
  id        String   @id @default(cuid())
  userId    String
  title     String
  coverUrl  String?
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items HighlightItem[]

  @@index([userId])
}

model HighlightItem {
  id          String   @id @default(cuid())
  highlightId String
  imageUrl    String
  createdAt   DateTime @default(now())

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([highlightId])
}






// User-submitted reports (moderation queue).
//
// Polymorphic-lite: one row targets exactly one of POST / COMMENT / MESSAGE /
// STORY (targetType + the matching FK). "One report per user per target" is
// enforced in reportTarget() via findFirst, not a DB unique — nullable FKs
// don't collide in Postgres unique indexes.
model Report {
  id         String     @id @default(cuid())
  targetType String     @default("POST") // POST | COMMENT | MESSAGE | STORY
  postId     String?
  commentId  String?
  messageId  String?
  storyId    String?
  reporterId String
  moderatorId String? // admin who actioned this report
  reason     String
  status     String     @default("open") // open | dismissed | actioned
  createdAt  DateTime   @default(now())

  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  story     Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter  User      @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User?     @relation("moderator", fields: [moderatorId], references: [id])

  @@index([status])
  @@index([postId])
}

// In-app notification. `actor` did something that concerns `user`.
// type: "comment" | "like" | "follow" | "application" | "message"
model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}




// Explicit interest signal feeding the feed ranker ("more like this" /
// "less like this"). One verdict per user per post. The matching table
// already exists in production Neon — created additively; adding the
// model here only keeps future prisma db push runs from dropping it.
model PostFeedback {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  value     String // "interested" | "not_interested"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// Sponsored placements — first-party only, zero tracking, honest labels.
// headline is enforced <=200 chars at the app layer (assertClean + length).
model Ad {
  id          String    @id @default(cuid())
  advertiser  String
  headline    String
  imageUrl    String? // Cloudinary (or local dev upload), optional
  targetUrl   String // https:// only — validated at creation/update
  placement   String // "FEED" | "SIDEBAR"
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, placement])
}

// ?????? Polls (E's polls feature ??? DRAFT shape, reconcile with E's ticket
//    before the schema window executes) ???????????????????????????????????????????????????????????????????????????????????????????????????
// One poll per post. Options are a fixed 2-4 entry JSON array validated at
// the app layer: [{ "id": "a", "text": "..." }, ...]. One vote per user per
// poll; switching = update the existing vote's optionId.
model Poll {
  id        String   @id @default(cuid())
  postId    String   @unique
  question  String
  options   Json
  createdAt DateTime @default(now())

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([postId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}
